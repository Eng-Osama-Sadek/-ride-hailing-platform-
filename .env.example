# =============================================================================
# انسخ هذا الملف إلى .env ثم غيّر كل القيم المكتوب فيها change_me
# لا ترفع .env إلى Git أبداً.
# توليد سر قوي:  openssl rand -base64 48      |   أو:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# =============================================================================

# ---------- PostgreSQL ----------
DB_USER=ride_admin
# استخدم أحرفاً وأرقاماً فقط (الرموز الخاصة تحتاج URL-encoding داخل DATABASE_URL)
DB_PASSWORD=change_me_db_password
DB_NAME=ridehailing
DB_PORT=5432
# يُستخدم عند تشغيل أوامر Prisma من خارج Docker (docker-compose يستبدله داخلياً)
DATABASE_URL=postgresql://ride_admin:change_me_db_password@localhost:5432/ridehailing?schema=public

# ---------- Redis ----------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change_me_redis_password

# ---------- Auth / JWT ----------
# 32 حرفاً على الأقل
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# ---------- OTP ----------
# mock = الكود ثابت (MOCK_OTP_CODE) ويُطبع في console  |  sms = مزود حقيقي (Production)
# النظام يرفض الإقلاع إذا كان NODE_ENV=production و OTP_MODE=mock
OTP_MODE=mock
MOCK_OTP_CODE=123456
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=5
# Production فقط (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ---------- HTTP ----------
PORT=3000
# مصادر مسموحة لـ CORS (لوحة التحكم). تطبيقات الموبايل لا تتأثر بـ CORS.
CORS_ORIGINS=http://localhost:5173
SWAGGER_ENABLED=true
# عدد الـ proxies أمام الـ API (0 محلياً، 1 خلف Nginx في الإنتاج) — يؤثر على Rate Limiting
TRUST_PROXY_HOPS=0

# ---------- Object Storage (S3-compatible) ----------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=ride-documents
S3_ACCESS_KEY=change_me_access_key
S3_SECRET_KEY=change_me_secret_key_min_8_chars
S3_FORCE_PATH_STYLE=true

# ---------- Mail (Mailhog) ----------
SMTP_HOST=localhost
SMTP_PORT=1025

# ---------- Seed (بيئة التطوير فقط) ----------
SEED_ADMIN_PASSWORD=change_me_Admin12345

# ---------- Maps / Push / Encryption (تُستخدم في مراحل لاحقة) ----------
GOOGLE_MAPS_API_KEY=
FIREBASE_PROJECT_ID=
# مفتاح 32 بايت base64 لتشفير الحقول الحساسة (الرقم القومي)
ENCRYPTION_KEY=
